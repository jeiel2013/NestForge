{
  "name": "nestforge-generator",
  "version": "0.2.0",
  "description": "Interactive CLI for generating a NestJS project from a NestForge starter template",
  "license": "MIT",
  "author": {
    "name": "Jeiel Alves",
    "url": "https://github.com/jeiel2013"
  },
  "type": "module",
  "bin": {
    "nestforge": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:templates",
    "copy:templates": "node scripts/copy-templates.mjs",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/generator.test.ts",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "nestjs",
    "cli",
    "generator",
    "scaffolding",
    "boilerplate",
    "starter",
    "typescript",
    "javascript",
    "prisma",
    "typeorm",
    "drizzle",
    "authentication",
    "postgresql",
    "mysql",
    "sqlite",
    "docker",
    "swagger",
    "api",
    "backend"
  ],
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "picocolors": "^1.1.0",
    "fs-extra": "^11.2.0",
    "gradient-string": "^2.0.2",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "@types/gradient-string": "^1.1.6",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeiel2013/nestforge.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/jeiel2013/NestForge#readme",
  "bugs": {
    "url": "https://github.com/jeiel2013/NestForge/issues"
  }
}
