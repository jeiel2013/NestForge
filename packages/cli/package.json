{
  "name": "nestforge",
  "version": "0.1.0",
  "description": "CLI para gerar um projeto NestJS a partir do boilerplate NestForge",
  "license": "MIT",
  "author": "Jeiel Alves <https://github.com/jeiel2013>",
  "type": "module",
  "bin": {
    "nestforge": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:templates",
    "copy:templates": "node scripts/copy-templates.mjs",
    "dev": "tsx src/index.ts",
    "lint": "eslint \"src/**/*.ts\" --fix"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "picocolors": "^1.1.0",
    "fs-extra": "^11.2.0",
    "gradient-string": "^2.0.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "@types/gradient-string": "^1.1.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jeiel2013/nestforge.git",
    "directory": "packages/cli"
  }
}
