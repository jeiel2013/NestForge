{
  "name": "nestforge",
  "version": "0.1.0",
  "description": "Production-ready NestJS starter with Drizzle ORM, Authentication, Docker, Testing, CI/CD and Clean Architecture.",
  "license": "MIT",
  "author": "Jeiel Alves <https://github.com/jeiel2013>",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "dotenv -e .env.test -- vitest run --config ./vitest.e2e.config.ts",
    "drizzle:generate": "dotenv -e .env -- drizzle-kit generate",
    "drizzle:migrate": "dotenv -e .env -- drizzle-kit migrate",
    "drizzle:push": "dotenv -e .env -- drizzle-kit push",
    "drizzle:studio": "dotenv -e .env -- drizzle-kit studio",
    "pretest:e2e": "dotenv -e .env.test -- drizzle-kit migrate",
    "seed": "dotenv -e .env -- ts-node src/database/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "express-session": "^1.19.0",
    "bullmq": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "nestjs-pino": "^4.1.0",
    "nestjs-zod": "^3.0.0",
    "nodemailer": "^6.9.15",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-google-oauth20": "^2.0.0",
    "passport-github2": "^0.1.12",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "mysql2": "^3.24.2",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-github2": "^1.2.9",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@swc/core": "^1.13.0",
    "unplugin-swc": "^1.5.10",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^7.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "drizzle-kit": "^0.31.10",
    "@types/pg": "^8.23.1",
    "@types/better-sqlite3": "^9.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
